[Unit]
Description=LinuxVM share-link
PartOf=graphical-session.target
After=graphical-session-pre.target
ConditionPathExists=/sys/bus/virtio/drivers/9pnet_virtio
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/linuxvm/share.py link
ExecStopPost=/usr/bin/python3 /usr/lib/linuxvm/share.py unlink
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
