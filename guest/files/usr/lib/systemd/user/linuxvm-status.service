[Unit]
Description=LinuxVM status
PartOf=graphical-session.target
After=graphical-session-pre.target
ConditionPathExists=/dev/virtio-ports/dev.linuxvm.status
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/linuxvm/status.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
