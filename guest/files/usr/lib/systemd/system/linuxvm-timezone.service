[Unit]
Wants=systemd-udev-settle.service
Description=Follow the LinuxVM host time zone
After=systemd-timedated.service systemd-udev-settle.service
ConditionPathExists=/dev/virtio-ports/dev.linuxvm.timezone
StartLimitIntervalSec=0

[Service]
Type=simple
ImportCredential=linuxvm.host
StateDirectory=linuxvm
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/lib/linuxvm/timezone.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
