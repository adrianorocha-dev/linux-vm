++        }
++        struct slirp_local_subnet *subnet = &local_subnets[local_subnet_count++];
++        memset(subnet, 0, sizeof(*subnet));
++        subnet->family = family;
++        local_subnet_bytes(ifa->ifa_addr, family, subnet->address);
++        local_subnet_bytes(ifa->ifa_netmask, family, subnet->mask);
++    }
++    freeifaddrs(interfaces);
++#endif
++}
