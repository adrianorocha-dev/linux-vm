diff --git a/macos/Tests/test-cocoa-touch-scroll-direction.py b/macos/Tests/test-cocoa-touch-scroll-direction.py
new file mode 100644
index 0000000..e9a5f56
--- /dev/null
+++ b/macos/Tests/test-cocoa-touch-scroll-direction.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""Touch-scroll contacts follow the fingers whatever the Mac's scroll direction."""
+
+import hashlib
+import os
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import tempfile
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[2]
+PATCHES = ROOT / "macos/patches"
+DIRECTION = PATCHES / "qemu-cocoa-touch-scroll-direction.patch"
+
+
+def added_file(patch, path):
+    section = patch.read_text().split(f"diff --git a/{path} b/{path}\n", 1)[1]
+    section = section.split("\ndiff --git ", 1)[0]
+    return "".join(line[1:] + "\n" for line in section.splitlines()
+                   if line.startswith("+") and not line.startswith("+++"))
+
+
+def section(patch, path):
+    return patch.read_text().split(f"diff --git a/{path} b/{path}\n", 1)[1].split("\ndiff --git ", 1)[0]
+
+
+class TouchScrollDirectionTests(unittest.TestCase):
+    def test_contacts_follow_the_fingers(self):
+        with tempfile.TemporaryDirectory() as directory:
+            work = Path(directory)
+            header = work / "include/ui/cocoa-touch-scroll.h"
+            header.parent.mkdir(parents=True)
+            header.write_text(added_file(PATCHES / "qemu-cocoa-touch-scroll.patch",
+                                         "include/ui/cocoa-touch-scroll.h"))
+            path = "include/ui/cocoa-touch-scroll.h"
+            for text in [(PATCHES / "qemu-cocoa-touch-scroll-scale.patch").read_text(),
+                         f"diff --git a/{path} b/{path}\n" + section(DIRECTION, path)]:
+                subprocess.run(["patch", "-s", "-p1", "-f", "-d", str(work)], input=text, text=True, check=True)
+            (work / "test.c").write_text(r'''
+#include <assert.h>
+#include "include/ui/cocoa-touch-scroll.h"
+
+static CocoaTouchScrollFrame last;
+
+static void record(void *opaque, const CocoaTouchScrollFrame *frame)
+{
+    last = *frame;
+}
+
+/* ui/cocoa.m's handleTouchScrollLocked: undo the Mac's natural scrolling. */
+static double device(double appkit, bool inverted)
+{
+    double direction = inverted ? -1.0 : 1.0;
+
+    return direction * appkit;
+}
+
+/*
+ * AppKit's scrollingDelta for fingers moving (fx, fy) points, right and down
+ * positive. Without natural scrolling, positive deltas scroll toward the top
+ * and left, which is the fingers moving up and left.
+ */
+static void move(CocoaTouchScroll *s, double fx, double fy, bool natural)
+{
+    double sign = natural ? 1.0 : -1.0;
+
+    cocoa_touch_scroll_event(s, 0, true, device(sign * fx, natural),
+                             device(sign * fy, natural), record, NULL);
+}
+
+static void fingers(double fx, double fy, bool natural, int *x, int *y)
+{
+    CocoaTouchScroll s = {0};
+
+    cocoa_touch_scroll_event(&s, COCOA_TOUCH_SCROLL_BEGIN, true, 0, 0, record, NULL);
+    move(&s, fx, fy, natural);
+    move(&s, fx, fy, natural);
+    *x = (last.x[0] + last.x[1]) / 2 - COCOA_TOUCH_SCROLL_CENTER;
+    *y = last.y - COCOA_TOUCH_SCROLL_CENTER;
+}
+
+int main(void)
+{
+    for (int natural = 0; natural < 2; natural++) {
+        int x, y;
+
+        fingers(0, 10, natural, &x, &y);
+        assert(x == 0 && y > 0);
+        fingers(0, -10, natural, &x, &y);
+        assert(x == 0 && y < 0);
+        fingers(10, 0, natural, &x, &y);
+        assert(x > 0 && y == 0);
+        fingers(-10, 0, natural, &x, &y);
+        assert(x < 0 && y == 0);
+    }
+    return 0;
+}
+''')
+            compiler = shlex.split(os.environ.get("CC", "cc"))
+            subprocess.run(compiler + ["-std=c11", "-Wall", "-Wextra", "-Werror", "-Wno-unused-parameter",
+                                       "-Wno-unused-function", str(work / "test.c"), "-lm", "-o", str(work / "test")],
+                           check=True)
+            subprocess.run([str(work / "test")], check=True)
+
+    def test_cocoa_undoes_the_mac_direction_on_both_axes(self):
+        cocoa = added_file(DIRECTION, "ui/cocoa.m")
+        self.assertIn("double direction = [event isDirectionInvertedFromDevice] ? -1.0 : 1.0;", cocoa)
+        self.assertIn("direction * [event scrollingDeltaX],", cocoa)
+        self.assertIn("direction * [event scrollingDeltaY],", cocoa)
+
+    def test_builder_verifies_and_applies_it_after_the_other_cocoa_patches(self):
+        builder = (ROOT / "macos/build-qemu-gpu-runtime.sh").read_text()
+        expected = re.search(r"^touch_scroll_direction_patch_sha256=([a-f0-9]{64})$", builder, re.M)
+        self.assertIsNotNone(expected)
+        self.assertEqual(hashlib.sha256(DIRECTION.read_bytes()).hexdigest(), expected[1])
+        applies = re.findall(r'^patch -d "\$source_dir" -p1 -f -i "\$(\w+)"$', builder, re.M)
+        self.assertEqual(applies[-1], "touch_scroll_direction_patch")
+        self.assertLess(applies.index("touch_scroll_scale_patch"), applies.index("touch_scroll_direction_patch"))
+
+
+if __name__ == "__main__":
+    unittest.main()
