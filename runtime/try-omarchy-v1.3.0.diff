diff --git a/macos/patches/qemu-cocoa-touch-scroll-scale.patch b/macos/patches/qemu-cocoa-touch-scroll-scale.patch
new file mode 100644
index 0000000..6194fb3
--- /dev/null
+++ b/macos/patches/qemu-cocoa-touch-scroll-scale.patch
@@ -0,0 +1,95 @@
+From: Ubuntu prototype
+Subject: [PATCH] cocoa: make the touch-scroll travel adjustable
+
+Applies after the touch-scroll patch. GNOME has no touchpad scroll factor,
+so the host scales the contacts' travel instead (see the header comment).
+
+--- a/include/ui/cocoa-touch-scroll.h
++++ b/include/ui/cocoa-touch-scroll.h
+@@ -7,6 +7,8 @@
+ #define QEMU_COCOA_TOUCH_SCROLL_H
+ 
+ #include <stdbool.h>
++#include <stdio.h>
++#include <stdlib.h>
+ #include <math.h>
+ 
+ /*
+@@ -35,7 +37,61 @@
+  * direction, in a frame of its own, starts it, so no scrolling is lost.
+  */
+ #define COCOA_TOUCH_SCROLL_PREROLL 16.0
++
++/*
++ * Prototype: scales the contacts' travel for guests without a touchpad scroll
++ * factor, such as GNOME, where Omarchy's Hyprland applies 0.4. The scale is
++ * read at every landing from the file TRYOMARCHY_TOUCH_SCROLL_SCALE_FILE
++ * names, so it can be tuned while the VM runs, or else from
++ * TRYOMARCHY_TOUCH_SCROLL_SCALE. Values outside 0.05-4 are clamped; anything
++ * unreadable keeps the last scale. The first move that starts libinput's
++ * scroll is not scaled, so scrolls still start at once.
++ */
++static inline double cocoa_touch_scroll_parse_scale(const char *text,
++                                                    double fallback)
++{
++    char *end;
++    double value;
++
++    if (!text) {
++        return fallback;
++    }
++    value = strtod(text, &end);
++    while (*end == ' ' || *end == '\n' || *end == '\r' || *end == '\t') {
++        end++;
++    }
++    if (end == text || *end != '\0' || !isfinite(value)) {
++        return fallback;
++    }
++    return fmin(4.0, fmax(0.05, value));
++}
+ 
++static double cocoa_touch_scroll_current_scale = 1.0;
++
++static inline void cocoa_touch_scroll_refresh_scale(void)
++{
++    static bool initialized;
++    const char *path = getenv("TRYOMARCHY_TOUCH_SCROLL_SCALE_FILE");
++
++    if (!initialized) {
++        initialized = true;
++        cocoa_touch_scroll_current_scale = cocoa_touch_scroll_parse_scale(
++            getenv("TRYOMARCHY_TOUCH_SCROLL_SCALE"), 1.0);
++    }
++    if (path) {
++        char text[32] = { 0 };
++        FILE *file = fopen(path, "r");
++
++        if (file) {
++            if (fgets(text, sizeof(text), file)) {
++                cocoa_touch_scroll_current_scale = cocoa_touch_scroll_parse_scale(
++                    text, cocoa_touch_scroll_current_scale);
++            }
++            fclose(file);
++        }
++    }
++}
++
+ typedef struct CocoaTouchScroll {
+     bool active;
+     /* The current AppKit gesture reached the guest as finger scrolling. */
+@@ -106,6 +162,7 @@
+                                             CocoaTouchScrollEmit emit,
+                                             void *opaque)
+ {
++    cocoa_touch_scroll_refresh_scale();
+     scroll->active = true;
+     scroll->owns_momentum = true;
+     scroll->started = false;
+@@ -166,6 +223,7 @@
+ {
+     double points = hypot(dx, dy);
+     double units = COCOA_TOUCH_SCROLL_UNITS_PER_POINT *
++                   cocoa_touch_scroll_current_scale *
+                    cocoa_touch_scroll_gain(points);
+ 
+     if (!scroll->started) {
diff --git a/macos/patches/virgl-core-instance-id.patch b/macos/patches/virgl-core-instance-id.patch
new file mode 100644
index 0000000..e1d1c89
--- /dev/null
+++ b/macos/patches/virgl-core-instance-id.patch
@@ -0,0 +1,22 @@
+From: Ubuntu prototype
+Subject: [PATCH] vrend: no GL_ARB_draw_instanced directive from GLSL 1.40
+
+Core-profile hosts get GLSL 1.40 or later, where gl_InstanceID is built in.
+macOS's GLSL 4.10 compiler rejects "#extension GL_ARB_draw_instanced : require",
+so every shader that reads gl_InstanceID failed to compile and its draws were
+dropped. Skip the directive as the loop already does for ARB_texture_rectangle.
+
+--- a/src/vrend/vrend_shader.c
++++ b/src/vrend/vrend_shader.c
+@@ -6362,6 +6362,11 @@
+          if (shader_req_table[i].key == SHADER_REQ_SAMPLER_RECT && ctx->glsl_ver_required >= 140)
+             continue;
+ 
++         /* gl_InstanceID is core from GLSL 1.40. macOS's GLSL 4.10 compiler
++          * rejects the extension directive, and the draws are lost. */
++         if (shader_req_table[i].key == SHADER_REQ_INSTANCE_ID && ctx->glsl_ver_required >= 140)
++            continue;
++
+          if (ctx->shader_req_bits & shader_req_table[i].key) {
+             emit_ext(glsl_strbufs, shader_req_table[i].string, "require");
+          }
