+include the Mac's natural scrolling, so the contacts moved the way macOS
+had chosen, and a guest that also applies natural scrolling, such as
+GNOME by default, reversed it again. The contacts now follow the fingers,
+so the guest's own natural-scrolling setting decides the direction. The
+wheel path still uses the Mac's direction.
+
+diff --git a/include/ui/cocoa-touch-scroll.h b/include/ui/cocoa-touch-scroll.h
+index 4753659..a29f3d9 100644
+--- a/include/ui/cocoa-touch-scroll.h
++++ b/include/ui/cocoa-touch-scroll.h
+@@ -213,8 +213,10 @@ static inline void cocoa_touch_scroll_place(CocoaTouchScroll *scroll,
+ }
+ 
+ /*
+- * Contacts move as libinput's default, non-natural finger scrolling expects,
+- * so the guest scrolls in the direction the wheel path used.
++ * dx and dy are AppKit's deltas without the Mac's natural scrolling, so
++ * positive values are the fingers moving left and up. The contacts move with
++ * the fingers, and the guest's own natural-scrolling setting picks the
++ * direction, as on real hardware.
+  */
+ static inline void cocoa_touch_scroll_move(CocoaTouchScroll *scroll,
+                                            double dx, double dy,
+diff --git a/ui/cocoa.m b/ui/cocoa.m
+index 88ddc98..5209b53 100644
+--- a/ui/cocoa.m
++++ b/ui/cocoa.m
+@@ -1739,6 +1739,8 @@ - (bool) handleTouchScrollLocked:(NSEvent *)event
+     NSEventPhase phase = [event phase];
+     NSEventPhase momentum = [event momentumPhase];
+     NSPoint point = [self convertPoint:[event locationInWindow] fromView:nil];
++    /* Undo the Mac's natural scrolling; the guest applies its own setting. */
++    double direction = [event isDirectionInvertedFromDevice] ? -1.0 : 1.0;
+     unsigned action = 0;
+     bool eligible = [event hasPreciseScrollingDeltas] &&
+                     [event window] == [self window] &&
+@@ -1766,8 +1768,8 @@ - (bool) handleTouchScrollLocked:(NSEvent *)event
+         action |= COCOA_TOUCH_SCROLL_MOMENTUM_END;
+     }
+     return cocoa_touch_scroll_event(&touchScroll, action, eligible,
+-                                    [event scrollingDeltaX],
+-                                    [event scrollingDeltaY],
++                                    direction * [event scrollingDeltaX],
++                                    direction * [event scrollingDeltaY],
+                                     cocoa_touch_scroll_send_frame, NULL);
+ }
+ 
diff --git a/macos/patches/qemu-cocoa-touch-scroll-scale.patch b/macos/patches/qemu-cocoa-touch-scroll-scale.patch
new file mode 100644
index 0000000..6194fb3
--- /dev/null
+++ b/macos/patches/qemu-cocoa-touch-scroll-scale.patch
@@ -0,0 +1,95 @@
+From: Ubuntu prototype
+Subject: [PATCH] cocoa: make the touch-scroll travel adjustable
+
+Applies after the touch-scroll patch. GNOME has no touchpad scroll factor,
+so the host scales the contacts' travel instead (see the header comment).
+
+--- a/include/ui/cocoa-touch-scroll.h
++++ b/include/ui/cocoa-touch-scroll.h
+@@ -7,6 +7,8 @@
+ #define QEMU_COCOA_TOUCH_SCROLL_H
+ 
+ #include <stdbool.h>
++#include <stdio.h>
++#include <stdlib.h>
+ #include <math.h>
+ 
+ /*
+@@ -35,7 +37,61 @@
+  * direction, in a frame of its own, starts it, so no scrolling is lost.
+  */
+ #define COCOA_TOUCH_SCROLL_PREROLL 16.0
++
++/*
++ * Prototype: scales the contacts' travel for guests without a touchpad scroll
++ * factor, such as GNOME, where Omarchy's Hyprland applies 0.4. The scale is
++ * read at every landing from the file TRYOMARCHY_TOUCH_SCROLL_SCALE_FILE
++ * names, so it can be tuned while the VM runs, or else from
++ * TRYOMARCHY_TOUCH_SCROLL_SCALE. Values outside 0.05-4 are clamped; anything
++ * unreadable keeps the last scale. The first move that starts libinput's
++ * scroll is not scaled, so scrolls still start at once.
++ */
++static inline double cocoa_touch_scroll_parse_scale(const char *text,
++                                                    double fallback)
++{
++    char *end;
++    double value;
++
++    if (!text) {
++        return fallback;
++    }
++    value = strtod(text, &end);
++    while (*end == ' ' || *end == '\n' || *end == '\r' || *end == '\t') {
++        end++;
++    }
++    if (end == text || *end != '\0' || !isfinite(value)) {
++        return fallback;
++    }
++    return fmin(4.0, fmax(0.05, value));
++}
+ 
++static double cocoa_touch_scroll_current_scale = 1.0;
++
++static inline void cocoa_touch_scroll_refresh_scale(void)
++{
++    static bool initialized;
++    const char *path = getenv("TRYOMARCHY_TOUCH_SCROLL_SCALE_FILE");
++
++    if (!initialized) {
++        initialized = true;
++        cocoa_touch_scroll_current_scale = cocoa_touch_scroll_parse_scale(
++            getenv("TRYOMARCHY_TOUCH_SCROLL_SCALE"), 1.0);
++    }
++    if (path) {
++        char text[32] = { 0 };
++        FILE *file = fopen(path, "r");
++
++        if (file) {
++            if (fgets(text, sizeof(text), file)) {
++                cocoa_touch_scroll_current_scale = cocoa_touch_scroll_parse_scale(
++                    text, cocoa_touch_scroll_current_scale);
++            }
++            fclose(file);
++        }
++    }
++}
++
+ typedef struct CocoaTouchScroll {
+     bool active;
+     /* The current AppKit gesture reached the guest as finger scrolling. */
+@@ -106,6 +162,7 @@
+                                             CocoaTouchScrollEmit emit,
+                                             void *opaque)
+ {
++    cocoa_touch_scroll_refresh_scale();
+     scroll->active = true;
+     scroll->owns_momentum = true;
+     scroll->started = false;
+@@ -166,6 +223,7 @@
+ {
+     double points = hypot(dx, dy);
+     double units = COCOA_TOUCH_SCROLL_UNITS_PER_POINT *
++                   cocoa_touch_scroll_current_scale *
+                    cocoa_touch_scroll_gain(points);
+ 
+     if (!scroll->started) {
