++#define LOCAL_SUBNETS_MAX 64
++#define LOCAL_SUBNETS_REFRESH_USEC (2 * G_USEC_PER_SEC)
++
++/* The host's interface subnets, re-read at most every two seconds so a
++ * network change is picked up without a getifaddrs() per UDP packet. */
++static struct slirp_local_subnet local_subnets[LOCAL_SUBNETS_MAX];
++static size_t local_subnet_count;
++static gint64 local_subnets_read_at;
++static bool local_subnets_read;
++
++static void local_subnet_bytes(const struct sockaddr *sa, int family, uint8_t *out)
++{
++    struct sockaddr_storage copy;
++    size_t length = sizeof(copy);
++
++    memset(&copy, 0, sizeof(copy));
++#ifdef __APPLE__
++    /* Darwin trims trailing zero bytes from netmasks. */
++    length = MIN((size_t)sa->sa_len, sizeof(copy));
++#endif
++    memcpy(&copy, sa, length);
++    if (family == AF_INET) {
++        memcpy(out, &((struct sockaddr_in *)&copy)->sin_addr, 4);
++    } else {
++        memcpy(out, &((struct sockaddr_in6 *)&copy)->sin6_addr, 16);
++    }
++}
++
++static void refresh_local_subnets(void)
++{
++    gint64 now = g_get_monotonic_time();
++
++    if (local_subnets_read && now - local_subnets_read_at < LOCAL_SUBNETS_REFRESH_USEC) {
++        return;
++    }
++    local_subnets_read = true;
++    local_subnets_read_at = now;
++    local_subnet_count = 0;
++#ifndef _WIN32
++    struct ifaddrs *interfaces;
++    if (getifaddrs(&interfaces) != 0) {
++        return;
++    }
++    for (struct ifaddrs *ifa = interfaces; ifa && local_subnet_count < LOCAL_SUBNETS_MAX;
++         ifa = ifa->ifa_next) {
++        if (!ifa->ifa_addr || !ifa->ifa_netmask || !(ifa->ifa_flags & IFF_UP)) {
