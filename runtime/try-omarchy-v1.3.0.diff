+#!/bin/bash
+
+# Archives are transport only. Recreate them from verified Git objects on every
+# use, so neither gzip metadata nor a cached archive can change the source.
+pinned_git_source_archive() {
+  local url=$1 commit=$2 prefix=$3 output=$4 cache=$5
+  local repository="$cache/git/$prefix.git"
+  [[ $commit =~ ^[a-f0-9]{40}$ ]] || { echo "invalid source commit: $commit" >&2; return 1; }
+  mkdir -p "$cache/git" "$(dirname "$output")"
+  if [[ ! -e $repository ]]; then
+    git init --bare --quiet "$repository" || return 1
+  fi
+  [[ -d $repository && ! -L $repository ]] || return 1
+  if ! GIT_NO_REPLACE_OBJECTS=1 git --git-dir="$repository" cat-file -e "$commit^{commit}" 2>/dev/null; then
+    GIT_NO_REPLACE_OBJECTS=1 git --git-dir="$repository" fetch --quiet --depth=1 "$url" "$commit" || return 1
+  fi
+  [[ $(GIT_NO_REPLACE_OBJECTS=1 git --git-dir="$repository" rev-parse "$commit^{commit}") == "$commit" ]] || return 1
+  GIT_NO_REPLACE_OBJECTS=1 git --git-dir="$repository" fsck --full --no-reflogs || return 1
+  GIT_NO_REPLACE_OBJECTS=1 git --git-dir="$repository" archive --format=tar --prefix="$prefix/" "$commit" |
+    gzip -n >"$output.partial" || return 1
+  mv -f "$output.partial" "$output"
+}
