diff --git a/macos/patches/virgl-core-instance-id.patch b/macos/patches/virgl-core-instance-id.patch
new file mode 100644
index 0000000..e1d1c89
--- /dev/null
+++ b/macos/patches/virgl-core-instance-id.patch
@@ -0,0 +1,22 @@
+From: Ubuntu prototype
+Subject: [PATCH] vrend: no GL_ARB_draw_instanced directive from GLSL 1.40
+
+Core-profile hosts get GLSL 1.40 or later, where gl_InstanceID is built in.
+macOS's GLSL 4.10 compiler rejects "#extension GL_ARB_draw_instanced : require",
+so every shader that reads gl_InstanceID failed to compile and its draws were
+dropped. Skip the directive as the loop already does for ARB_texture_rectangle.
+
+--- a/src/vrend/vrend_shader.c
++++ b/src/vrend/vrend_shader.c
+@@ -6362,6 +6362,11 @@
+          if (shader_req_table[i].key == SHADER_REQ_SAMPLER_RECT && ctx->glsl_ver_required >= 140)
+             continue;
+ 
++         /* gl_InstanceID is core from GLSL 1.40. macOS's GLSL 4.10 compiler
++          * rejects the extension directive, and the draws are lost. */
++         if (shader_req_table[i].key == SHADER_REQ_INSTANCE_ID && ctx->glsl_ver_required >= 140)
++            continue;
++
+          if (ctx->shader_req_bits & shader_req_table[i].key) {
+             emit_ext(glsl_strbufs, shader_req_table[i].string, "require");
+          }
diff --git a/macos/pinned-git-source.sh b/macos/pinned-git-source.sh
new file mode 100644
index 0000000..f49e044
--- /dev/null
+++ b/macos/pinned-git-source.sh
@@ -0,0 +1,22 @@
+#!/bin/bash
+
+# Archives are transport only. Recreate them from verified Git objects on every
+# use, so neither gzip metadata nor a cached archive can change the source.
+pinned_git_source_archive() {
+  local url=$1 commit=$2 prefix=$3 output=$4 cache=$5
+  local repository="$cache/git/$prefix.git"
+  [[ $commit =~ ^[a-f0-9]{40}$ ]] || { echo "invalid source commit: $commit" >&2; return 1; }
+  mkdir -p "$cache/git" "$(dirname "$output")"
+  if [[ ! -e $repository ]]; then
+    git init --bare --quiet "$repository" || return 1
+  fi
+  [[ -d $repository && ! -L $repository ]] || return 1
+  if ! GIT_NO_REPLACE_OBJECTS=1 git --git-dir="$repository" cat-file -e "$commit^{commit}" 2>/dev/null; then
+    GIT_NO_REPLACE_OBJECTS=1 git --git-dir="$repository" fetch --quiet --depth=1 "$url" "$commit" || return 1
+  fi
+  [[ $(GIT_NO_REPLACE_OBJECTS=1 git --git-dir="$repository" rev-parse "$commit^{commit}") == "$commit" ]] || return 1
+  GIT_NO_REPLACE_OBJECTS=1 git --git-dir="$repository" fsck --full --no-reflogs || return 1
+  GIT_NO_REPLACE_OBJECTS=1 git --git-dir="$repository" archive --format=tar --prefix="$prefix/" "$commit" |
+    gzip -n >"$output.partial" || return 1
+  mv -f "$output.partial" "$output"
+}
